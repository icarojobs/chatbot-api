# Copie para .env.production (ignorado pelo git) e preencha. Usado por:
#   make deploy-env    -> grava estas variáveis no projeto da Vercel
#   make copy-db-neon  -> copia a base local (chatbot_prod) para o Neon
#   make ingest-prod   -> ingestão das apostilas direto no Neon
# API_ENV, TRUSTED_PROXY_HOPS e DIRECT_UPLOAD_MAX_BYTES são fixados pelo scripts/deploy/vercel.sh.

# Neon (região AWS São Paulo; connection string DIRETA, sem "-pooler", com o prefixo postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://<usuario>:<senha>@<endpoint>.sa-east-1.aws.neon.tech/<banco>?sslmode=require

# Provedor de modelos (produção)
OPENAI_BASE_URL=
OPENAI_ACCESS_KEY=
OPENAI_RESPONSE_MODELS="azure/gpt-5-mini,azure/gpt-6-luna"
OPENAI_EMBEDDINGS_MODELS="cohere/embed-v4.0"

# Tokens da API (gere novos para produção: openssl rand -hex 32)
API_ACCESS_TOKEN=
API_ADMIN_TOKEN=
