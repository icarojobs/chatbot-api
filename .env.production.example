# Copie para .env.production (ignorado pelo git) e preencha. Usado por:
#   scripts/deploy/cloud_run.sh  -> segredos e variáveis do Cloud Run
#   make ingest-prod             -> ingestão das apostilas no banco de produção

# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=southamerica-east1
SERVICE_NAME=chatbot-api

# Neon (use a connection string DIRETA, sem "-pooler", trocando o prefixo para postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://<usuario>:<senha>@<endpoint>.neon.tech/<banco>?sslmode=require

# Provedor de modelos (produção)
OPENAI_BASE_URL=
OPENAI_ACCESS_KEY=
OPENAI_RESPONSE_MODELS="azure/gpt-5-mini,azure/gpt-6-luna"
OPENAI_EMBEDDINGS_MODELS="cohere/embed-v4.0"

# Tokens da API (gere novos para produção: openssl rand -hex 32)
API_ACCESS_TOKEN=
API_ADMIN_TOKEN=

