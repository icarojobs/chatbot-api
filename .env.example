API_ENV=development
LOG_LEVEL=INFO

# Tokens Bearer da API (mínimo 32 caracteres). Gere com: openssl rand -hex 32
API_ACCESS_TOKEN=
API_ADMIN_TOKEN=

RATE_LIMIT_DEFAULT=60/minute
# Quantidade de proxies confiáveis à frente da API (Cloud Run = 1; local = 0)
TRUSTED_PROXY_HOPS=0

OPENAI_BASE_URL=
OPENAI_ACCESS_KEY=
OPENAI_RESPONSE_MODELS=""
OPENAI_EMBEDDINGS_MODELS=""

POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot

# Portas no host (altere se já estiverem em uso)
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
OLLAMA_HOST_PORT=11434

# MCP Postgres (somente leitura) do Claude Code: exporte no shell antes de abrir a sessão
# export MCP_POSTGRES_URI=postgresql://chatbot:<senha>@localhost:<POSTGRES_HOST_PORT>/chatbot
