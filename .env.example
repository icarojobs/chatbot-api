# Ambiente para execução no host (make run, CLI). No Docker, use make up (dev) ou make up-prod (provedor real).
API_ENV=development
LOG_LEVEL=INFO

# Tokens Bearer da API (mínimo 32 caracteres). Gere com: openssl rand -hex 32
API_ACCESS_TOKEN=
API_ADMIN_TOKEN=

RATE_LIMIT_DEFAULT=60/minute
# Quantidade de proxies confiáveis à frente da API (Cloud Run = 1; local = 0)
TRUSTED_PROXY_HOPS=0

OPENAI_BASE_URL=
OPENAI_ACCESS_KEY=
OPENAI_RESPONSE_MODELS=""
OPENAI_EMBEDDINGS_MODELS=""

# Provedor em API_ENV=development (Ollama). No docker compose a URL é sobrescrita para o serviço "ollama".
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_RESPONSE_MODELS="qwen3:4b-instruct-2507-q4_K_M"
OLLAMA_EMBEDDINGS_MODELS="bge-m3:567m"

PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=1
# Modelos de raciocínio (ex.: gpt-5-mini) consomem parte desse limite pensando
LLM_MAX_OUTPUT_TOKENS=1500

# RAG: similaridade mínima (cosseno) para um trecho virar contexto. Vazio = valor calibrado
# para o modelo de embedding ativo (bge-m3: 0.47, cohere/embed-v4.0: 0.27; ver ADR-0006).
RAG_MIN_SCORE=
RAG_TOP_K_DEFAULT=4
RAG_TOP_K_MAX=8
RAG_CONTEXT_MAX_CHARS=18000

UPLOAD_MAX_BYTES=52428800
UPLOAD_TTL_MINUTES=60
# Upload direto (POST /v1/documents): limite por requisição; acima disso, use o upload em partes.
DIRECT_UPLOAD_MAX_BYTES=31457280
# Reset da base (DELETE /v1/documents?confirm=true). Sem a variável: habilitado em development e desabilitado em production.
# DOCUMENTS_RESET_ENABLED=true

POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot
# Usado pela CLI/API fora do Docker (no docker compose a URL é montada para o serviço "postgres")
DATABASE_URL=postgresql+psycopg://chatbot:<senha>@localhost:<POSTGRES_HOST_PORT>/chatbot
# Banco isolado dos testes de integração (make test); crie com: docker compose exec postgres createdb -U chatbot chatbot_test
TEST_DATABASE_URL=postgresql+psycopg://chatbot:<senha>@localhost:<POSTGRES_HOST_PORT>/chatbot_test

# Portas no host (altere se já estiverem em uso)
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
OLLAMA_HOST_PORT=11434

# MCP Postgres (somente leitura) do Claude Code: exporte no shell antes de abrir a sessão
# export MCP_POSTGRES_URI=postgresql://chatbot:<senha>@localhost:<POSTGRES_HOST_PORT>/chatbot
